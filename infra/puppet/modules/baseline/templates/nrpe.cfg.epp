<%- | String $ops_host_private_ip = '' | -%>
# Nagios NRPE Server configuration for app-host (managed consistently by Ansible and Puppet)
log_facility=daemon
pid_file=/run/nagios/nrpe.pid
server_port=5666
nrpe_user=nagios
nrpe_group=nagios
allowed_hosts=127.0.0.1,::1<%= $ops_host_private_ip ? { '' => '', default => ",${ops_host_private_ip}" } %>
dont_blame_nrpe=0
allow_bash_command_substitution=0
debug=0
command_timeout=60
connection_timeout=300
include_dir=/etc/nagios/nrpe.d/
