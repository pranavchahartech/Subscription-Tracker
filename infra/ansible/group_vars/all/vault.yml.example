---
# Example Ansible Vault variables file for SubSpace.
# Copy this file to group_vars/all/vault.yml, replace placeholder values,
# and encrypt it with: ansible-vault encrypt group_vars/all/vault.yml
# NEVER commit an unencrypted vault.yml file to Git.

vault_postgres_db: subscriptions
vault_postgres_user: admin
vault_postgres_password: CHANGE_ME_STRONG_DB_PASSWORD

vault_jwt_secret: CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS
vault_jwt_refresh_secret: CHANGE_ME_JWT_REFRESH_SECRET_AT_LEAST_32_CHARS
vault_jwt_reset_secret: CHANGE_ME_JWT_RESET_SECRET_AT_LEAST_32_CHARS

vault_smtp_host: smtp.gmail.com
vault_smtp_port: 587
vault_smtp_user: your_smtp_user@gmail.com
vault_smtp_pass: your_smtp_app_password

vault_nagios_admin_password: CHANGE_ME_NAGIOS_PASSWORD
