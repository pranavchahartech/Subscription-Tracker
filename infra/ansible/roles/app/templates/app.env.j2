# Production environment variables for SubSpace (generated by Ansible from Vault)
NODE_ENV=production
PORT=4000
COOKIE_SECURE={{ cookie_secure }}
IMAGE_TAG={{ app_image_tag }}

# PostgreSQL 15 configuration
POSTGRES_DB={{ vault_postgres_db }}
POSTGRES_USER={{ vault_postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
DATABASE_URL=postgres://{{ vault_postgres_user }}:{{ vault_postgres_password }}@postgres:5432/{{ vault_postgres_db }}

# JWT secrets (no defaults)
JWT_SECRET={{ vault_jwt_secret }}
JWT_REFRESH_SECRET={{ vault_jwt_refresh_secret }}
JWT_RESET_SECRET={{ vault_jwt_reset_secret }}

# SMTP reminder email configuration
SMTP_HOST={{ vault_smtp_host }}
SMTP_PORT={{ vault_smtp_port }}
SMTP_USER={{ vault_smtp_user }}
SMTP_PASS={{ vault_smtp_pass }}
