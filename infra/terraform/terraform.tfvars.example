# Example Terraform variables file for SubSpace
# Copy this file to terraform.tfvars and replace the placeholder IPs with your own.
# NEVER commit terraform.tfvars to Git.

aws_region          = "ap-southeast-2"
project_name        = "SubSpace"
ssh_public_key_path = "~/.ssh/devops-key.pub"

# Public IP of your control node (/32) — used for SSH (port 22)
admin_cidr = "YOUR_CONTROL_NODE_IP/32"

# Your workstation/laptop public IP (/32) — used for SubSpace (port 80) and Nagios UI (port 80)
my_ip_cidr = "YOUR_WORKSTATION_IP/32"
