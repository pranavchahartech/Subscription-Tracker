# SubSpace Master Environment Template
# Copy this file to .env and fill in real values

# Database
POSTGRES_DB=subscriptions
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret
DATABASE_URL=postgres://admin:secret@postgres:5432/subscriptions

# Ports
PORT=4000
VITE_API_URL=http://localhost:4000

# Authentication Secrets (REQUIRED - NO FALLBACKS)
JWT_SECRET=your_super_secret_jwt_access_key_change_me_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_me_in_production
JWT_RESET_SECRET=your_super_secret_jwt_reset_key_change_me_in_production

# Email SMTP Delivery (Gmail or SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
